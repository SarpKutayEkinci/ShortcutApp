<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher" Height="60" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">

    <Border Background="#2D2D2D" CornerRadius="15" BorderBrush="AntiqueWhite" BorderThickness="1">
        <TextBox x:Name="MySearchTextBox" 
                 FontSize="20" Background="Transparent" Foreground="White" 
                 BorderThickness="0" Margin="15,5" VerticalContentAlignment="Center"
                 KeyDown="MySearchTextBox_KeyDown"/>
    </Border>
</Window>